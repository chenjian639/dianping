<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.trade.mapper.OrderMapper">

    <select id="selectMerchantOrdersPage"
            resultType="com.trade.entity.Order">
        SELECT *
        FROM orders
        WHERE merchant_id = #{merchantId}

        <if test="status != null">
            AND status = #{status}
        </if>

        ORDER BY created_at DESC
        LIMIT #{pageSize}
        OFFSET #{offset}
    </select>

    <select id="countMerchantOrders"
            resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM orders
        WHERE merchant_id = #{merchantId}

        <if test="status != null">
            AND status = #{status}
        </if>
    </select>

</mapper>