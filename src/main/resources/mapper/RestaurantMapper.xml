<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dianping.mapper.RestaurantMapper">

    <select id="searchByKeywordPage"
            resultType="com.dianping.vo.RestaurantSearchVO">
        <choose>
            <when test="sort == 'latest'">
                SELECT
                r.id,
                r.name,
                r.description,
                r.address,
                r.average_rating AS averageRating,
                r.review_count AS reviewCount
                FROM restaurant r
                WHERE r.status = 1

                <if test="keyword != null and keyword != ''">
                    AND MATCH(r.name)
                    AGAINST(
                    #{keyword}
                    IN NATURAL LANGUAGE MODE
                    )
                </if>

                ORDER BY
                r.created_at DESC,
                r.id DESC

                LIMIT #{pageSize}
                OFFSET #{offset}
            </when>
            <otherwise>
                SELECT
                r.id,
                r.name,
                r.description,
                r.address,
                r.average_rating AS averageRating,
                r.review_count AS reviewCount

                FROM restaurant r

                WHERE r.status = 1

                <if test="keyword != null and keyword != ''">
                    AND MATCH(r.name)
                    AGAINST(
                    #{keyword}
                    IN NATURAL LANGUAGE MODE
                    )
                </if>

                <choose>
                    <when test="sort == 'rating'">
                        ORDER BY
                        r.average_rating DESC,
                        r.id DESC
                    </when>

                    <otherwise>
                        ORDER BY
                        r.review_count DESC,
                        r.id DESC
                    </otherwise>
                </choose>

                LIMIT #{pageSize}
                OFFSET #{offset}
            </otherwise>
        </choose>
    </select>

</mapper>
